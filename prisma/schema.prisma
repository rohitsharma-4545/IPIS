generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model PdcDevice {
  id          Int      @id @default(autoincrement())
  vendor      String
  device      String   // "PDC"
  ip          String   @unique
  pf          String   @unique
  lastSeen    DateTime @updatedAt

  displayDevices DisplayDevice[]

  @@index([vendor])
  @@index([pf])
}
 
model Train {
  id        Int      @id @default(autoincrement())
  tno       String   @unique
  tne       String
  tnh       String
  tnr       String
  adf       String
  eat       String?
  edt       String
  pno       String
  sta       String
  ccd       String
  updatedAt DateTime @updatedAt

  @@index([pno])
}

model LineConfig {
  id        Int      @id @default(autoincrement())
  int       Int
  pto       Int
  dto       Int
  chr       Int
  eff       Int
  spd       Int
  msg       String?
  mst       String?
  tod       String
  rst       String
  updatedAt DateTime @updatedAt
}

model DisplayDevice {
  id         Int      @id @default(autoincrement())
  vendor     String
  device     String
  ip         String   @unique

  pf         String
  pno        Int?

  int        Int
  hsr        String
  lastPoll   DateTime @updatedAt

  pdcDevice  PdcDevice @relation(fields: [pf], references: [pf], onDelete: Cascade)

  @@index([vendor])
  @@index([pf])
  @@index([pno])
}

model PdcConfig {
  id  Int    @id @default(1)

  nod Int    // No of displays
  tod String
  rst String

  updatedAt DateTime @updatedAt
}

